  "upstreamReviewed": true,
  "mergeWitnessRunBeforeWrite": false,
  "blindness": "Evidence-derived precommitted oracle; upstream issue and fix were reviewed; not a fully blind evaluation.",
  "primarySources": [
    "https://github.com/mcollina/fastq/issues/80",
    "https://github.com/mcollina/fastq/pull/81",
    "https://github.com/mcollina/fastq/blob/b8d99205b36f9a0e8063ab9c84f6a92757d59ced/README.md",
